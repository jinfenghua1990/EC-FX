# 应用
APP_VERSION=0.8.4
APP_IMAGE_TAG=local

# PostgreSQL（已有 V0.4 数据库请先保持 recon，不要直接改密码）
POSTGRES_PASSWORD=recon

# 构建依赖镜像。群晖访问官方 PyPI 较慢时使用国内镜像。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_DEFAULT_TIMEOUT=120
PIP_RETRIES=10

# 旺店通正式授权
WDT_SID=jxf
WDT_APPKEY=jxf-gw
WDT_APPSECRET=
WDT_BASE_URL=https://api.wangdian.cn/openapi2/
WDT_TIMEOUT_SECONDS=30

RECON_AMOUNT_TOLERANCE=0.02

# GitHub 在线更新（V0.6.2+）
# 私有仓库建议 Fine-grained PAT，仅给目标仓库 Contents: Read-only。
GITHUB_REPO=jinfenghua1990/ecommerce-reconciliation
GITHUB_BRANCH=main
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
